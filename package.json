{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview --port 4214",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "typegen:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "audit": "node scripts/audit.mjs",
    "test:conversion": "node --experimental-strip-types --test scripts/conversion/tests/*.test.ts",
    "test:deployment": "node --test scripts/deployment/tests/*.test.mjs",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "smoke:cloudflare:local": "node scripts/deployment-smoke.mjs http://127.0.0.1:4214 --local-workerd",
    "check:runtime-env": "node scripts/check-runtime-env.mjs",
    "verify:conversion": "node --experimental-strip-types scripts/conversion/verify.ts",
    "preflight:conversion": "node scripts/conversion/preflight.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.70",
    "clsx": "^2.1.1",
    "lenis": "^1.3.24",
    "lucide-react": "^1.0.1",
    "motion": "^12.38.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-use-measure": "^2.1.7",
    "resend": "^6.35.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotted-map": "^3.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "html-validate": "^11.5.5",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.155.0"
  }
}
